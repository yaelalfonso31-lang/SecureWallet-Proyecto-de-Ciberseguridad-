# Copia este archivo a .env  (o ejecuta: python scripts/generate_env.py)
# NUNCA subas .env a GitHub.

ENVIRONMENT=dev

# Bases de datos (SQLite por defecto en desarrollo; PostgreSQL con docker-compose)
WALLET_DATABASE_URL=sqlite:///./wallet.db
BANK_DATABASE_URL=sqlite:///./bank.db
STORE_DATABASE_URL=sqlite:///./store.db

# Sesiones (JWT)
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15

# JWT propio del Banco (aud="bank"). Debe ser DISTINTO de JWT_SECRET.
BANK_JWT_SECRET=

# Cifrado de datos en reposo (AES-256-GCM, 32 bytes en base64url)
DATA_ENCRYPTION_KEY=

# Firma electrónica (Ed25519, base64url)
WALLET_SIGNING_PRIVATE_KEY=
WALLET_SIGNING_PUBLIC_KEY=
BANK_SIGNING_PRIVATE_KEY=
BANK_SIGNING_PUBLIC_KEY=

# Comunicación servicio a servicio
BANK_API_KEY=
BANK_URL=http://localhost:8002
